# sealhouse build of fulcio-server on Red Hat Hardened Images (Hummingbird).
ARG BUILDER
ARG RUNTIME

FROM ${BUILDER} AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY main.go main.go
COPY cmd/ cmd/
COPY pkg/ pkg/
COPY internal/ internal/
ARG LDFLAGS=""
RUN CGO_ENABLED=0 GOFIPS140=v1.26.0 go build -trimpath -ldflags "-buildid= ${LDFLAGS}" \
      -o /out/usr/local/bin/fulcio-server .
# The server writes nothing at runtime: its config (/etc/fulcio-config) and CA
# key material are mounted, so no writable directories are created here.

FROM ${RUNTIME}
COPY --from=builder /out/usr/local/bin/fulcio-server /usr/local/bin/fulcio-server
ENTRYPOINT ["/usr/local/bin/fulcio-server"]
CMD ["serve"]
